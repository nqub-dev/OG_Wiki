---
import wiki from '../../wiki.config';
import Navbar from '../components/Navbar.astro';
import Sidebar from '../components/Sidebar.astro';
import Footer from '../components/Footer.astro';
import { url } from '../lib/links';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  current?: string;
  /** Page id, used to pick the generated OG image (e.g. "start-here/welcome"). */
  ogId?: string;
}

const { title, description, current, ogId } = Astro.props;
const pageTitle = title ? `${title} · ${wiki.name}` : `${wiki.name} — ${wiki.tagline}`;
const pageDescription = description ?? wiki.description;
const canonical = new URL(Astro.url.pathname, Astro.site ?? 'https://example.com');

// Social crawlers require absolute URLs, and only accept raster images.
const ogImage =
  wiki.ogImage.enabled && ogId ? new URL(url(`og/${ogId}.png`), canonical).href : undefined;
---

<!doctype html>
<html lang="en" data-theme={wiki.themes.light}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={pageDescription} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href={url('sitemap-index.xml')} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={wiki.name} />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {ogImage && <meta property="og:image:width" content="1200" />}
    {ogImage && <meta property="og:image:height" content="630" />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      wiki.favicon ? (
        <link rel="icon" href={url(wiki.favicon)} />
      ) : (
        <link
          rel="icon"
          href={`data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32"><text y="26" font-size="26">${encodeURIComponent(wiki.mark)}</text></svg>`}
        />
      )
    }

    {/* Apply the stored theme before first paint to avoid a flash. */}
    <script is:inline define:vars={{ fallback: wiki.themes.light }}>
      const stored = localStorage.getItem('og-wiki-theme');
      document.documentElement.setAttribute('data-theme', stored || fallback);
    </script>
  </head>

  <body class="bg-base-100 text-base-content min-h-screen antialiased">
    <a
      href="#main"
      class="btn btn-primary btn-sm sr-only focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-50"
      >Skip to content</a
    >

    <div class="drawer lg:drawer-open">
      <input id="wiki-drawer" type="checkbox" class="drawer-toggle" />

      <div class="drawer-content flex min-h-screen flex-col">
        <Navbar />
        <main id="main" class="flex-1">
          <slot />
        </main>
        <Footer />
      </div>

      <div class="drawer-side z-40">
        <label for="wiki-drawer" aria-label="Close navigation" class="drawer-overlay"></label>
        <Sidebar current={current} />
      </div>
    </div>
  </body>
</html>
