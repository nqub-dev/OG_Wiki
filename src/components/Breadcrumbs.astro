---
interface Props {
  crumbs: { label: string; href: string }[];
}

const { crumbs } = Astro.props;
---

<nav class="breadcrumbs text-base-content/60 py-0 text-sm" aria-label="Breadcrumb">
  <ul>
    {
      crumbs.map((crumb, index) => (
        <li>
          {index === crumbs.length - 1 ? (
            <span class="text-base-content font-medium" aria-current="page">
              {crumb.label}
            </span>
          ) : (
            <a href={crumb.href} class="link link-hover">
              {crumb.label}
            </a>
          )}
        </li>
      ))
    }
  </ul>
</nav>
