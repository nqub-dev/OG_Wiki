---
import type { Doc } from '../lib/content';
import { docUrl } from '../lib/links';

interface Props {
  prev?: Doc;
  next?: Doc;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="mt-12 grid gap-3 sm:grid-cols-2" aria-label="Page navigation">
      {prev ? (
        <a
          href={docUrl(prev.id)}
          class="card card-border bg-base-100 border-base-300 hover:border-primary hover:bg-base-200 group transition-colors"
        >
          <div class="card-body gap-1 p-4">
            <span class="text-base-content/50 flex items-center gap-1 text-xs">
              <svg
                class="size-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="m15 5-7 7 7 7" />
              </svg>
              Previous
            </span>
            <span class="group-hover:text-primary font-semibold transition-colors">
              {prev.data.icon} {prev.data.title}
            </span>
          </div>
        </a>
      ) : (
        <span />
      )}

      {next && (
        <a
          href={docUrl(next.id)}
          class="card card-border bg-base-100 border-base-300 hover:border-primary hover:bg-base-200 group text-right transition-colors sm:col-start-2"
        >
          <div class="card-body items-end gap-1 p-4">
            <span class="text-base-content/50 flex items-center gap-1 text-xs">
              Next
              <svg
                class="size-3"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                aria-hidden="true"
              >
                <path d="m9 5 7 7-7 7" />
              </svg>
            </span>
            <span class="group-hover:text-primary font-semibold transition-colors">
              {next.data.title} {next.data.icon}
            </span>
          </div>
        </a>
      )}
    </nav>
  )
}
