---
/**
 * Brand wordmark.
 *
 * ── Swapping this for a client ────────────────────────────────
 * Replace the <path> elements below with their SVG, keeping two rules:
 *   1. Shapes that should follow the theme use fill="currentColor".
 *   2. Fixed brand accents use var(--brand-accent, #hex).
 * Then update the viewBox and the `alt`/aria-label text.
 *
 * Because the wordmark inherits currentColor, it stays legible on all 37
 * daisyUI themes without shipping light and dark copies.
 */
interface Props {
  /** Tailwind height class. Defaults to a navbar-appropriate size. */
  class?: string;
}

const { class: className = 'h-6 w-auto' } = Astro.props;
