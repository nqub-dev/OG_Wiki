---
import wiki from '../../wiki.config';
import { url } from '../lib/links';
---

<footer class="footer bg-base-200 border-base-300 text-base-content border-t p-8 lg:px-12">
  <aside>
    <span class="bg-primary text-primary-content grid size-9 place-items-center rounded-xl"
      >{wiki.mark}</span
    >
    <p class="font-semibold">{wiki.name}</p>
    <p class="text-base-content/60 max-w-xs text-sm">{wiki.tagline}</p>
  </aside>

  {
    wiki.footer.map((column) => (
      <nav>
        <h2 class="footer-title">{column.heading}</h2>
        {column.links.map((link) => (
          <a class="link link-hover" href={url(link.href)}>
            {link.label}
          </a>
        ))}
      </nav>
    ))
  }
</footer>
