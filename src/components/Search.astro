---
/**
 * Static full-text search powered by Pagefind.
 * The index is generated by `pagefind --site dist` during `npm run build`,
 * so results appear in `npm run preview` / production, not in `astro dev`.
 */
import { url } from '../lib/links';

const pagefindJs = url('pagefind/pagefind-ui.js');
const pagefindCss = url('pagefind/pagefind-ui.css');
---

<button
  class="btn btn-sm bg-base-200 border-base-300 hover:bg-base-300 w-full max-w-xs justify-start gap-2 font-normal shadow-none"
  data-search-open
  aria-label="Search the wiki"
>
  <svg
    class="size-4 opacity-60"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
  </svg>
  <span class="opacity-60">Search…</span>
  <kbd class="kbd kbd-xs ml-auto hidden sm:inline-flex">⌘</kbd>
  <kbd class="kbd kbd-xs hidden sm:inline-flex">K</kbd>
</button>

<dialog id="search-modal" class="modal modal-middle">
  <div class="modal-box max-w-2xl p-0">
    <div class="border-base-300 flex items-center gap-2 border-b px-4 py-3">
      <svg
        class="size-4 opacity-60"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        aria-hidden="true"
      >
        <circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>
      </svg>
      <span class="text-sm font-semibold">Search the wiki</span>
      <form method="dialog" class="ml-auto">
        <button class="btn btn-ghost btn-xs" aria-label="Close search">
          <kbd class="kbd kbd-xs">esc</kbd>
        </button>
      </form>
    </div>

    <div id="search" class="max-h-[60vh] min-h-32 overflow-y-auto px-4 py-3">
      <div id="search-fallback" class="alert alert-info alert-soft text-sm">
        <span>Loading search…</span>
      </div>
    </div>
  </div>
  <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>

<script is:inline define:vars={{ pagefindJs, pagefindCss }}>
  (() => {
    const modal = document.getElementById('search-modal');
    let state = 'idle';

    /**
     * Pagefind ships an IIFE that assigns `window.PagefindUI`. We inject a plain
     * <script> tag rather than using `import()`, because Vite rewrites dynamic
     * imports through its preload helper and leaves an unresolved
     * `__VITE_PRELOAD__` reference for paths it does not own.
     */
    function loadScript(src) {
      return new Promise((resolve, reject) => {
        if (document.querySelector('script[src="' + src + '"]')) return resolve();
        const el = document.createElement('script');
        el.src = src;
        el.onload = () => resolve();
        el.onerror = () => reject(new Error('Failed to load ' + src));
        document.head.appendChild(el);
      });
    }

    async function mountPagefind() {
      if (state !== 'idle') return;
      state = 'loading';

      const fallback = document.getElementById('search-fallback');
      try {
        const css = document.createElement('link');
        css.rel = 'stylesheet';
        css.href = pagefindCss;
        document.head.appendChild(css);

        await loadScript(pagefindJs);
        if (!window.PagefindUI) throw new Error('PagefindUI unavailable');

        if (fallback) fallback.remove();
        new window.PagefindUI({
          element: '#search',
          showSubResults: true,
          showImages: false,
          resetStyles: false,
          // Faceted search over section / status / tag, built from
          // data-pagefind-filter attributes on each page.
          showFilters: true,
        });
        state = 'ready';
        setTimeout(() => {
          const input = document.querySelector('#search input');
          if (input) input.focus();
        }, 50);
      } catch {
        state = 'idle'; // let it retry once the index exists
        if (fallback) {
          fallback.innerHTML =
            '<span>Search index not built yet. Run <code>npm run preview</code> or <code>npm run build</code>.</span>';
        }
      }
    }

    function open() {
      if (modal) modal.showModal();
      mountPagefind();
    }

    document.querySelectorAll('[data-search-open]').forEach((el) => {
      el.addEventListener('click', open);
    });

    document.addEventListener('keydown', (event) => {
      const target = event.target;
      const typing = !!target && /^(INPUT|TEXTAREA|SELECT)$/.test(target.tagName);

      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'k') {
        event.preventDefault();
        open();
      } else if (event.key === '/' && !typing && !(modal && modal.open)) {
        event.preventDefault();
        open();
      }
    });
  })();
</script>
