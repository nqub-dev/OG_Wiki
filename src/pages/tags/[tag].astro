---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import DocCard from '../../components/DocCard.astro';
import { getTags } from '../../lib/content';
import { homeUrl, tagUrl } from '../../lib/links';

export async function getStaticPaths() {
  const tags = await getTags();
  return tags.map(({ tag, docs }) => ({ params: { tag }, props: { tag, docs } }));
}

const { tag, docs } = Astro.props;
---

<BaseLayout title={`#${tag}`} description={`Pages tagged #${tag}.`}>
  <div class="mx-auto w-full max-w-5xl px-4 py-10 lg:px-8">
    <Breadcrumbs
      crumbs={[
        { label: 'Wiki', href: homeUrl() },
        { label: 'Tags', href: tagUrl() },
        { label: `#${tag}`, href: tagUrl(tag) },
      ]}
    />

    <h1 class="mt-3 flex items-center gap-3 text-3xl font-bold tracking-tight">
      <span class="badge badge-primary badge-lg">#{tag}</span>
    </h1>
    <p class="text-base-content/70 mt-2">{docs.length} pages</p>

    <div class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {docs.map((doc) => <DocCard doc={doc} />)}
    </div>
  </div>
</BaseLayout>
