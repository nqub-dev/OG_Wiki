{
  "name": "og-wiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A cloneable, brandable wiki template. Astro + Tailwind CSS 4 + daisyUI 5.",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "npm run build && astro preview",
    "check": "astro check",
    "sync": "astro sync",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:links": "node scripts/check-links.mjs",
    "check:a11y": "node scripts/check-a11y.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "npm run check && npm run check:links -- --strict && npm run build && npm run check:a11y -- --strict"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.4",
    "@astrojs/mdx": "^7.0.8",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.0",
    "astro": "^7.2.7",
    "astro-og-canvas": "^0.13.0",
    "daisyui": "5.5.20",
    "github-slugger": "^2.0.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.0",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^5.9.2"
  }
}
